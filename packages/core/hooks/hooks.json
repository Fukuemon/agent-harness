{
  "description": "ファイルの編集の後に、足されたコメントと lint の抑制を確かめるよう促す",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check-comments.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
