{
  "name": "agent-harness",
  "private": true,
  "license": "MIT",
  "scripts": {
    "lint:text": "textlint \"*.md\" \"adr/*.md\" \"design/**/*.md\" \"packages/**/*.md\" \"context/*.md\" \"skills/**/*.md\" \".github/**/*.md\"",
    "lint:packages": "node scripts/check-package-names.mjs",
    "prepare": "lefthook install",
    "check:project": "node packages/core/scripts/validate-project.mjs",
    "test": "node --test \"packages/**/*.test.mjs\" \"scripts/*.test.mjs\"",
    "check:index": "node packages/core/scripts/build-index.mjs",
    "check:history": "node packages/docs/hooks/check-history.mjs",
    "check:links": "node packages/docs/hooks/check-links.mjs",
    "list:drift": "node packages/docs/hooks/list-drift.mjs",
    "check:kit": "tsc -p packages/e2e/kit/tsconfig.json && cd packages/e2e/kit && npm pack --dry-run"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "1.59.1",
    "@types/node": "^24.19.2",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "lefthook": "^2.1.14",
    "textlint": "^15.8.0",
    "textlint-rule-no-mix-dearu-desumasu": "^6.0.4",
    "textlint-rule-preset-ai-words-ja": "^1.2.1",
    "textlint-rule-prh": "^6.1.0",
    "textlint-rule-sentence-length": "^5.2.1",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "yaml": "^2.9.1"
  }
}
