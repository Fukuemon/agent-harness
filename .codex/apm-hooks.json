{
  "PostToolUse": [
    {
      "matcher": "Edit|Write|MultiEdit",
      "hooks": [
        {
          "type": "command",
          "command": "f=\".codex/hooks/core/hooks/check-comments.mjs\"; [ -f \"$f\" ] || exit 0; node \"$f\"",
          "timeout": 10
        }
      ],
      "_apm_source": "_local/core"
    }
  ],
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && [ -f apm.lock.yaml ] && [ ! -d .claude/hooks/core ] && [ ! -d .codex/hooks/core ] && command -v apm >/dev/null && apm install --frozen >&2; exit 0",
          "timeout": 120
        }
      ],
      "_apm_source": "_local/core"
    }
  ]
}
