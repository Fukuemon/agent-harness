{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/core/hooks/check-comments.mjs\"; [ -f \"$f\" ] || exit 0; node \"$f\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && [ -f apm.lock.yaml ] && grep -q 'hooks/core/' apm.lock.yaml && [ ! -d .claude/hooks/core ] && [ ! -d .codex/hooks/core ] && command -v apm >/dev/null && apm install --frozen >&2; exit 0",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
